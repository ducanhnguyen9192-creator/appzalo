HOST=127.0.0.1
PORT=3001
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
TRUSTED_PROXY_IPS=
# Leave empty for direct connections. Behind a proxy, list its exact IPs only.
# The proxy must overwrite/append X-Forwarded-For correctly; do not trust arbitrary headers.
# DB_PATH defaults to backend/data/firstclass.sqlite
# Production: HTTPS, COOKIE_SECURE=true and an explicit allowed origin list.

# Email: leave these blank until a provider is available. Server-only secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public app URL (including deployment subpath, if any), HTTPS in production.
# Development may use http://localhost:5173 or http://127.0.0.1:5173.
APP_PUBLIC_URL=

# One-way Vietjet browser search. Windows with Chrome installed: chrome
# Linux server: leave empty and install Chromium with: npx playwright install --with-deps chromium
VIETJET_BROWSER_CHANNEL=chrome
# Optional automatic agency login. Set ONLY in backend/.env or server secrets.
# With both values set, dev:backend starts a headless browser on first search.
# Never use VITE_ prefixes for these credentials. Never commit backend/.env.
VIETJET_AGENT_USERNAME=
VIETJET_AGENT_PASSWORD=
